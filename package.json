{
  "name": "freedog-gateway",
  "version": "0.6.1",
  "description": "Provider-driven local AI agent proxy connecting Claude Code and Codex to free upstream models with automatic failover, real-time Ping latency, dynamic model fetch and quad-language WebUI",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "freedog": "./bin/freedog.mjs",
    "freedog-gateway": "./bin/freedog.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allahyoxi/freedog-gateway.git"
  },
  "homepage": "https://freeaidog.com",
  "scripts": {
    "start": "node bin/freedog.mjs start",
    "dev": "node bin/freedog.mjs start --verbose",
    "claude": "node bin/freedog.mjs claude",
    "test": "node test/run-tests.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "proxy",
    "free-ai",
    "llm-gateway",
    "providers",
    "webui"
  ],
  "author": "FreeAI Dog Core Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
